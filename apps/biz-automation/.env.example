# Copy to .env and fill in real values. Never commit the real .env file.

# Required — the server refuses to start without it. Generate with:
#   openssl rand -hex 32
BIZ_AUTOMATION_API_KEY=

# Optional — port the HTTP server listens on.
PORT=8080

# Optional — if set, the server regenerates the report on this interval
# (milliseconds) and serves it from GET /reports/latest.
REPORT_SCHEDULE_MS=3600000
