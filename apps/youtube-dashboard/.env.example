# Copy to .env (or export these) to switch from demo to live YouTube data.
# With none set, Maxforge Lab runs in demo mode.

# Port for the standalone server (default 3000)
PORT=3000

# YouTube Data API v3 key:
#   console.cloud.google.com -> enable "YouTube Data API v3" -> create API key
YOUTUBE_API_KEY=

# Your channel — @handle or a UC… channel id
MAXFORGE_CHANNEL=@yourhandle

# --- Daily-views chart in live mode (YouTube Analytics API, OAuth) ---
# Only the channel owner can read daily views. Get these once with:
#   YT_OAUTH_CLIENT_ID=... YT_OAUTH_CLIENT_SECRET=... node get-analytics-token.cjs
# (needs a "Desktop app" OAuth client from Google Cloud Console). Leave unset to
# hide the chart in live mode.
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REFRESH_TOKEN=

# --- AI features (AI Coach, Schlüsselwörter, Optimieren) ---
# Anthropic API key. Set this to enable the AI screens. The server proxies the
# calls, so the key stays server-side and never reaches the browser.
#   console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-4-8          # default model for the AI calls
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages   # e.g. a gateway/proxy

# --- Access control (see README → Deployment & security) ---
# The API routes are unauthenticated. Same-origin by default (no CORS). Set an
# origin only to expose them to a specific cross-origin front-end.
# CORS_ORIGIN=https://your-frontend.example
# Per-IP requests/min on /api/claude, /api/stats, /chart.json (0 disables):
# RATE_LIMIT_PER_MIN=60
