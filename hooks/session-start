#!/usr/bin/env bash
# SessionStart hook for the maxforge-lab plugin.
# Injects the using-maxforge bootstrap so skills reliably auto-trigger.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_maxforge_content=$(cat "${PLUGIN_ROOT}/skills/using-maxforge/SKILL.md" 2>&1 || echo "Error reading using-maxforge skill")

# Escape for JSON embedding (single-pass parameter substitutions).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_maxforge_escaped=$(escape_for_json "$using_maxforge_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have Maxforge Lab skills.\n\n**Below is the full content of your 'maxforge-lab:using-maxforge' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_maxforge_escaped}\n</EXTREMELY_IMPORTANT>"

# Emit only the field the current platform consumes (see superpowers issue #571
# re: bash 5.3+ heredoc hang — use printf, not heredoc).
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
